# ============================================================
# Document Factory — ForumPHs
# ============================================================

# Anthropic API — REQUIRED
ANTHROPIC_API_KEY=sk-ant-...

# Supabase UNRLVL — session persistence
NEXT_PUBLIC_SUPABASE_URL=https://amlvyycfepwhiindxgzw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# UNRLVL URL (server-side, no NEXT_PUBLIC_) — detectPlatform reads this first, falls
# back to NEXT_PUBLIC_SUPABASE_URL. URL pública, no es secreto. Debe existir en Vercel
# (Prod+Preview) o /api/parse degrada a Hypal por falta de URL (PR-C §1).
UNRLVL_SUPABASE_URL=https://amlvyycfepwhiindxgzw.supabase.co
# UNRLVL service_role (server-side) — reads df_platform_parsing_config in /api/parse (PR-B)
unrlvl_service_role=your_service_role_key_here

# Supabase ForumPHs — BI / FIE data (tajuoqdbnsnzkhyqvdgs)
FPHS_SUPABASE_URL=https://tajuoqdbnsnzkhyqvdgs.supabase.co
FPHS_SERVICE_KEY=your_service_role_key_here

# ── fphs-formalize endpoint auth (T3 §3.1) ──────────────────────────────────
# Shared secret gating the fphs-formalize Edge Function. The server proxy
# (/api/formalize) and reprocessPending attach it as the `x-formalize-secret`
# header; the EF rejects any request without it. Server-side ONLY — never
# NEXT_PUBLIC_ (a browser-readable secret is not a secret).
# Generate a NEW random value — do NOT reuse forumphs_document_factory or any
# existing key, e.g.:  openssl rand -hex 32
# Set the SAME value in BOTH places:
#   • Vercel env (this app, Prod+Preview)
#   • Supabase function secret:  supabase secrets set FPHS_FORMALIZE_SECRET=...
FPHS_FORMALIZE_SECRET=
# Optional override of the EF URL (defaults to the deployed fphs-formalize).
# FPHS_FORMALIZE_URL=https://amlvyycfepwhiindxgzw.supabase.co/functions/v1/fphs-formalize