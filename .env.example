# Anthropic API — REQUIRED
ANTHROPIC_API_KEY=sk-ant-...

# Supabase UNRLVL — session persistence
NEXT_PUBLIC_SUPABASE_URL=https://amlvyycfepwhiindxgzw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
# UNRLVL URL (server-side, no NEXT_PUBLIC_) — detectPlatform reads this first, falls
# back to NEXT_PUBLIC_SUPABASE_URL. URL pública, no es secreto. Debe existir en Vercel
# (Prod+Preview) o /api/parse degrada a Hypal por falta de URL (PR-C §1).
UNRLVL_SUPABASE_URL=https://amlvyycfepwhiindxgzw.supabase.co
# UNRLVL service_role (server-side) — reads df_platform_parsing_config in /api/parse (PR-B)
unrlvl_service_role=your_service_role_key_here

# Supabase ForumPHs — BI / FIE data (tajuoqdbnsnzkhyqvdgs)
FPHS_SUPABASE_URL=https://tajuoqdbnsnzkhyqvdgs.supabase.co
